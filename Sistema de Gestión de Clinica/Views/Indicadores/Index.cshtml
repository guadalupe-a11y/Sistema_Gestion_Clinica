@model Sistema_Gestión_Clinica.ViewModels.IndicadoresViewModel

@{
    ViewData["Title"] = "Panel de Indicadores";
    string fechaFiltro = Model.Fecha.ToString("yyyy-MM-dd");
}

<div class="container animate__animated animate__fadeIn">

    <!-- ENCABEZADO -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                Panel de Indicadores de Recepción
            </h2>

            <p class="text-muted mb-0">
                Consulta las estadísticas de pacientes y citas por fecha.
            </p>

            <!-- CALENDARIO PARA SELECCIONAR FECHA -->
            <form asp-controller="Indicadores"
                  asp-action="Index"
                  method="get"
                  class="d-flex align-items-center gap-2 mt-3 flex-wrap">

                <label for="fecha" class="text-muted mb-0">
                    Consultar fecha:
                </label>

                <input type="date"
                       id="fecha"
                       name="fecha"
                       value="@fechaFiltro"
                       class="form-control rounded-pill w-auto px-3"
                       onchange="this.form.submit()" />
            </form>
        </div>

        <!-- ACTUALIZAR INDICADORES -->
        <a asp-controller="Indicadores"
           asp-action="Index"
           asp-route-fecha="@fechaFiltro"
           class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="fa-solid fa-rotate me-1"></i>
            Actualizar Indicadores
        </a>
    </div>

    <!-- PRIMERA FILA DE INDICADORES -->
    <div class="row g-4 mb-4">

        <!-- TOTAL DE CITAS -->
        <div class="col-md-4">
            <a asp-controller="Recepcion"
               asp-action="Index"
               asp-route-estado="Todas"
               asp-route-fecha="@fechaFiltro"
               class="text-decoration-none">

                <div class="card card-hover border-0 shadow-sm p-4 text-center h-100">
                    <div class="text-primary mb-2">
                        <i class="fa-solid fa-calendar-check fs-1"></i>
                    </div>

                    <h6 class="text-muted fw-bold">
                        TOTAL CITAS DEL DÍA
                    </h6>

                    <h1 class="fw-bold text-primary display-4 mb-0">
                        @Model.TotalCitas
                    </h1>

                    <small class="text-primary mt-2 d-block">
                        Ver todas
                        <i class="fa-solid fa-arrow-right"></i>
                    </small>
                </div>
            </a>
        </div>

        <!-- CITAS PENDIENTES -->
        <div class="col-md-4">
            <a asp-controller="Recepcion"
               asp-action="Index"
               asp-route-estado="Agendada"
               asp-route-fecha="@fechaFiltro"
               class="text-decoration-none">

                <div class="card card-hover border-0 shadow-sm p-4 text-center h-100"
                     style="border-top: 4px solid #ffc107 !important;">

                    <div class="text-warning mb-2">
                        <i class="fa-solid fa-hourglass-half fs-1"></i>
                    </div>

                    <h6 class="text-muted fw-bold">
                        CITAS PENDIENTES
                    </h6>

                    <h1 class="fw-bold text-warning display-4 mb-0">
                        @Model.CitasPendientes
                    </h1>

                    <small class="text-warning mt-2 d-block">
                        Ver pendientes
                        <i class="fa-solid fa-arrow-right"></i>
                    </small>
                </div>
            </a>
        </div>

        <!-- PACIENTES EN ESPERA -->
        <div class="col-md-4">
            <a asp-controller="Recepcion"
               asp-action="Index"
               asp-route-estado="En Espera"
               asp-route-fecha="@fechaFiltro"
               class="text-decoration-none">

                <div class="card card-hover border-0 shadow-sm p-4 text-center h-100"
                     style="border-top: 4px solid #0dcaf0 !important;">

                    <div class="text-info mb-2">
                        <i class="fa-solid fa-user-clock fs-1"></i>
                    </div>

                    <h6 class="text-muted fw-bold">
                        PACIENTES EN ESPERA
                    </h6>

                    <h1 class="fw-bold text-info display-4 mb-0">
                        @Model.PacientesEnEspera
                    </h1>

                    <small class="text-info mt-2 d-block">
                        Ver en sala
                        <i class="fa-solid fa-arrow-right"></i>
                    </small>
                </div>
            </a>
        </div>
    </div>

    <!-- SEGUNDA FILA DE INDICADORES -->
    <div class="row g-4">

        <!-- CITAS FINALIZADAS -->
        <div class="col-md-4">
            <a asp-controller="Recepcion"
               asp-action="Index"
               asp-route-estado="Finalizada"
               asp-route-fecha="@fechaFiltro"
               class="text-decoration-none">

                <div class="card card-hover border-0 shadow-sm p-4 text-center h-100"
                     style="border-top: 4px solid #198754 !important;">

                    <div class="text-success mb-2">
                        <i class="fa-solid fa-circle-check fs-1"></i>
                    </div>

                    <h6 class="text-muted fw-bold">
                        CITAS FINALIZADAS
                    </h6>

                    <h1 class="fw-bold text-success display-4 mb-0">
                        @Model.CitasFinalizadas
                    </h1>

                    <small class="text-success mt-2 d-block">
                        Ver finalizadas e historial
                        <i class="fa-solid fa-arrow-right"></i>
                    </small>
                </div>
            </a>
        </div>

        <!-- CITAS CANCELADAS -->
        <div class="col-md-4">
            <a asp-controller="Recepcion"
               asp-action="Index"
               asp-route-estado="Cancelada"
               asp-route-fecha="@fechaFiltro"
               class="text-decoration-none">

                <div class="card card-hover border-0 shadow-sm p-4 text-center h-100"
                     style="border-top: 4px solid #dc3545 !important;">

                    <div class="text-danger mb-2">
                        <i class="fa-solid fa-ban fs-1"></i>
                    </div>

                    <h6 class="text-muted fw-bold">
                        CITAS CANCELADAS
                    </h6>

                    <h1 class="fw-bold text-danger display-4 mb-0">
                        @Model.CitasCanceladas
                    </h1>

                    <small class="text-danger mt-2 d-block">
                        Ver cancelaciones
                        <i class="fa-solid fa-arrow-right"></i>
                    </small>
                </div>
            </a>
        </div>

        <!-- PACIENTES NO PRESENTADOS -->
        <div class="col-md-4">
            <a asp-controller="Recepcion"
               asp-action="Index"
               asp-route-estado="No-Show"
               asp-route-fecha="@fechaFiltro"
               class="text-decoration-none">

                <div class="card card-hover border-0 shadow-sm p-4 text-center h-100">

                    <div class="text-secondary mb-2">
                        <i class="fa-solid fa-user-slash fs-1"></i>
                    </div>

                    <h6 class="text-muted fw-bold">
                        PACIENTES NO PRESENTADOS
                    </h6>

                    <h1 class="fw-bold text-secondary display-4 mb-0">
                        @Model.PacientesNoPresentados
                    </h1>

                    <small class="text-secondary mt-2 d-block">
                        Ver registros
                        <i class="fa-solid fa-arrow-right"></i>
                    </small>
                </div>
            </a>
        </div>
    </div>
</div>
