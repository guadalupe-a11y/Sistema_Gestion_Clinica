@model Sistema_Gestión_Clinica.Models.Cita

@{
    ViewData["Title"] = "Reprogramar cita cancelada";
    string fechaAnterior = Model.FechaHora.ToString("dd/MM/yyyy");
    string horaAnterior = Model.FechaHora.ToString("hh:mm tt");
}

<style>
    .reprogramar-contenedor {
        max-width: 850px;
        margin: 35px auto;
    }

    .reprogramar-encabezado {
        background: linear-gradient(90deg, #1166f5, #08b7d4);
        color: white;
        padding: 26px 30px;
        border-radius: 18px 18px 0 0;
    }

    .reprogramar-cuerpo {
        padding: 30px;
        background: white;
        border-radius: 0 0 18px 18px;
    }

    .reprogramar-dato {
        background: #f4f8ff;
        border-radius: 12px;
        padding: 15px;
    }

    .reprogramar-boton {
        background: linear-gradient(90deg, #1166f5, #08b7d4);
        color: white;
        border: none;
        border-radius: 50px;
        padding: 11px 26px;
        font-weight: 600;
    }

        .reprogramar-boton:hover {
            color: white;
            opacity: 0.9;
        }
</style>

<div class="container">

    <div class="reprogramar-contenedor shadow-sm">

        <!-- ENCABEZADO -->
        <div class="reprogramar-encabezado">
            <h3 class="fw-bold mb-2">
                <i class="fa-solid fa-calendar-days me-2"></i>
                Reprogramar Cita Cancelada
            </h3>

            <p class="mb-0">
                Seleccione una nueva fecha y hora para reactivar la cita.
            </p>
        </div>

        <div class="reprogramar-cuerpo">

            <!-- MENSAJES -->
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Error"]
                </div>
            }

            <!-- INFORMACIÓN DE LA CITA -->
            <h5 class="fw-bold mb-3">
                Información de la cita
            </h5>

            <div class="row g-3 mb-4">

                <div class="col-md-6">
                    <div class="reprogramar-dato">
                        <small class="text-muted">Paciente</small>
                        <div class="fw-bold">
                            @Model.Paciente?.Nombre
                            @Model.Paciente?.Apellido
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="reprogramar-dato">
                        <small class="text-muted">Médico</small>
                        <div class="fw-bold">
                            Dr. @Model.Medico?.Nombre
                            @Model.Medico?.Apellido
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="reprogramar-dato">
                        <small class="text-muted">Código de turno</small>
                        <div class="fw-bold">
                            @Model.CodigoTurno
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="reprogramar-dato">
                        <small class="text-muted">Fecha anterior</small>
                        <div class="fw-bold">
                            @fechaAnterior - @horaAnterior
                        </div>
                    </div>
                </div>

            </div>

            <hr class="my-4" />

            <!-- FORMULARIO -->
            <h5 class="fw-bold mb-3">
                Nueva programación
            </h5>

            <form asp-controller="Recepcion"
                  asp-action="ReprogramarCancelada"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="idCita"
                       value="@Model.IdCita" />

                <div class="row g-3">

                    <div class="col-md-6">
                        <label for="fecha"
                               class="form-label fw-semibold">
                            Nueva fecha
                        </label>

                        <input type="date"
                               id="fecha"
                               name="fecha"
                               class="form-control rounded-3"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")"
                               required />
                    </div>

                    <div class="col-md-6">
                        <label for="hora"
                               class="form-label fw-semibold">
                            Nueva hora
                        </label>

                        <input type="time"
                               id="hora"
                               name="hora"
                               class="form-control rounded-3"
                               required />
                    </div>

                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 flex-wrap">

                    <a asp-controller="Recepcion"
                       asp-action="Index"
                       class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="fa-solid fa-arrow-left me-1"></i>
                        Cancelar
                    </a>

                    <button type="submit"
                            class="btn reprogramar-boton">
                        <i class="fa-solid fa-floppy-disk me-2"></i>
                        Guardar Reprogramación
                    </button>

                </div>
            </form>
        </div>
    </div>
</div>
