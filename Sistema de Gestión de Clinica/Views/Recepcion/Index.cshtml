@model IEnumerable<Sistema_Gestión_Clinica.Models.Cita>

@{
    ViewData["Title"] = "Gestión de Recepción";

    string estadoFiltro = Context.Request.Query["estado"].ToString();

    if (string.IsNullOrEmpty(estadoFiltro))
    {
        estadoFiltro = "Todas";
    }

    string fechaFiltro = ViewBag.FechaFiltro
        ?? DateTime.Today.ToString("yyyy-MM-dd");

    DateTime fechaSeleccionada;
    if (!DateTime.TryParse(fechaFiltro, out fechaSeleccionada))
    {
        fechaSeleccionada = DateTime.Today;
    }
}

<div class="container animate__animated animate__fadeIn">

    <!-- ENCABEZADO -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="fa-solid fa-hospital-user text-primary me-2"></i>
                Recepción de Pacientes
            </h2>

            <!-- SELECTOR DE FECHA -->
            <form asp-controller="Recepcion"
                  asp-action="Index"
                  method="get"
                  class="d-flex align-items-center gap-2 mt-2 flex-wrap">

                <label for="fecha" class="text-muted mb-0">
                    Consultar citas de:
                </label>

                <input type="hidden"
                       name="estado"
                       value="@estadoFiltro" />

                <input type="date"
                       id="fecha"
                       name="fecha"
                       value="@fechaFiltro"
                       class="form-control rounded-pill w-auto px-3"
                       onchange="this.form.submit()" />
            </form>
        </div>

        <a asp-controller="Indicadores"
           asp-action="Index"
           class="btn btn-outline-secondary rounded-pill px-3">
            <i class="fa-solid fa-chart-pie me-1"></i>
            Volver a Indicadores
        </a>
    </div>

    <!-- PESTAÑAS DE FILTRADO POR ESTADO -->
    <div class="mb-4">
        <div class="btn-group w-100 shadow-sm rounded-pill overflow-hidden p-1 bg-white"
             role="group">

            <a asp-action="Index"
               asp-route-estado="Todas"
               asp-route-fecha="@fechaFiltro"
               class="btn btn-sm rounded-pill @(estadoFiltro == "Todas" ? "btn-primary" : "btn-light")">
                Todas
            </a>

            <a asp-action="Index"
               asp-route-estado="Agendada"
               asp-route-fecha="@fechaFiltro"
               class="btn btn-sm rounded-pill @(estadoFiltro == "Agendada" ? "btn-warning" : "btn-light")">
                Pendientes
            </a>

            <a asp-action="Index"
               asp-route-estado="En Espera"
               asp-route-fecha="@fechaFiltro"
               class="btn btn-sm rounded-pill @(estadoFiltro == "En Espera" ? "btn-info text-white" : "btn-light")">
                En Espera
            </a>

            <a asp-action="Index"
               asp-route-estado="Finalizada"
               asp-route-fecha="@fechaFiltro"
               class="btn btn-sm rounded-pill @(estadoFiltro == "Finalizada" ? "btn-success" : "btn-light")">
                Finalizadas
            </a>

            <a asp-action="Index"
               asp-route-estado="Cancelada"
               asp-route-fecha="@fechaFiltro"
               class="btn btn-sm rounded-pill @(estadoFiltro == "Cancelada" ? "btn-danger" : "btn-light")">
                Canceladas
            </a>

        </div>
    </div>

    <!-- TABLA DE CITAS -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Turno</th>
                                <th>Paciente</th>
                                <th>Médico / Especialidad</th>
                                <th>Hora Agendada</th>
                                <th>Estado</th>
                                <th class="text-center">Expediente y Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var cita in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="badge bg-primary fs-6">
                                            @cita.CodigoTurno
                                        </span>
                                    </td>

                                    <td>
                                        <div class="fw-bold">
                                            @cita.Paciente?.Nombre
                                            @cita.Paciente?.Apellido
                                        </div>
                                        <small class="text-muted">
                                            DUI: @cita.Paciente?.DUI
                                        </small>
                                    </td>

                                    <td>
                                        <div class="fw-bold">
                                            Dr. @cita.Medico?.Nombre
                                            @cita.Medico?.Apellido
                                        </div>
                                        <small class="text-muted">
                                            @cita.Medico?.Especialidad?.NombreEspecialidad
                                        </small>
                                    </td>

                                    <td>
                                        @cita.FechaHora.ToString("hh:mm tt")
                                    </td>

                                    <td>
                                        @if (cita.EstadoCita?.NombreEstado == "Agendada")
                                        {
                                            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">
                                                Agendada
                                            </span>
                                        }
                                        else if (cita.EstadoCita?.NombreEstado == "En Espera")
                                        {
                                            <span class="badge bg-info text-white px-3 py-2 rounded-pill">
                                                En Espera
                                            </span>
                                        }
                                        else if (cita.EstadoCita?.NombreEstado == "Finalizada")
                                        {
                                            <span class="badge bg-success px-3 py-2 rounded-pill">
                                                Finalizada
                                            </span>
                                        }
                                        else if (cita.EstadoCita?.NombreEstado == "Cancelada")
                                        {
                                            <span class="badge bg-danger px-3 py-2 rounded-pill">
                                                Cancelada
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary px-3 py-2 rounded-pill">
                                                @cita.EstadoCita?.NombreEstado
                                            </span>
                                        }
                                    </td>

                                    <td class="text-center">
                                        <a asp-controller="Recepcion"
                                           asp-action="VerExpediente"
                                           asp-route-idPaciente="@cita.IdPaciente"
                                           class="btn btn-sm btn-outline-info rounded-pill px-3 me-1">
                                            <i class="fa-solid fa-folder-open me-1"></i>
                                            Expediente
                                        </a>

                                        @if (cita.EstadoCita?.NombreEstado == "Agendada"
                                             && cita.FechaHora.Date == DateTime.Today)
                                        {
                                            <form asp-controller="Recepcion"
                                                  asp-action="MarcarLlegada"
                                                  method="post"
                                                  class="d-inline">

                                                <input type="hidden"
                                                       name="idCita"
                                                       value="@cita.IdCita" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-success rounded-pill px-3">
                                                    Check-In
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-5 text-center text-muted">
                    <i class="fa-solid fa-calendar-xmark display-4 mb-3"></i>
                    <h5>No se encontraron citas registradas para la fecha y el estado seleccionados</h5>
                </div>
            }

        </div>
    </div>
</div>
