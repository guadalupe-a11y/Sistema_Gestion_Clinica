@model Sistema_Gestión_Clinica.Models.Cita
@{
    ViewData["Title"] = "Atención Médica";
    var expediente = ViewBag.Expediente as Sistema_Gestión_Clinica.Models.Expediente;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary fw-bold">
            <i class="bi bi-stethoscope me-2"></i>Consulta Médica en Proceso
        </h2>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">
            <i class="bi bi-arrow-left me-1"></i> Volver a la Lista
        </a>
    </div>

    <div class="row g-4">
        <!-- Tarjeta de Datos del Paciente -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 mb-3">
                <div class="card-header bg-primary text-white rounded-top-4 py-3">
                    <h5 class="card-title mb-0"><i class="bi bi-person-circle me-2"></i>Datos del Paciente</h5>
                </div>
                <div class="card-body">
                    <p class="mb-2"><strong>Nombre:</strong> @Model.Paciente?.Nombre @Model.Paciente?.Apellido</p>
                    <p class="mb-2"><strong>DUI:</strong> @(Model.Paciente?.DUI ?? "N/A")</p>
                    <p class="mb-2"><strong>Teléfono:</strong> @(Model.Paciente?.Telefono ?? "N/A")</p>
                    <hr />
                    <p class="mb-2 text-muted"><strong>Fecha de Cita:</strong> @Model.FechaHora.ToString("dd/MM/yyyy HH:mm")</p>
                    <p class="mb-0 text-muted"><strong>Expediente N°:</strong> @(expediente?.IdExpediente.ToString() ?? "Sin Expediente")</p>
                </div>
            </div>
        </div>

        <!-- Formulario de Registro de Atención -->
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-3 text-secondary">Registro de Consulta</h4>

                    <form asp-action="FinalizarConsulta" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="idCita" value="@Model.IdCita" />

                        <div class="mb-3">
                            <label for="notas" class="form-label fw-semibold">Notas de Consulta / Síntomas</label>
                            <textarea id="notas" name="notas" class="form-rows-3 form-control rounded-3" rows="3" placeholder="Motivo de la visita, síntomas reportados por el paciente..." required></textarea>
                        </div>

                        <div class="mb-3">
                            <label for="diagnostico" class="form-label fw-semibold">Diagnóstico Médico</label>
                            <input type="text" id="diagnostico" name="diagnostico" class="form-control rounded-3" placeholder="Ej: Infección respiratoria aguda" required />
                        </div>

                        <div class="mb-4">
                            <label for="indicaciones" class="form-label fw-semibold">Indicaciones / Receta Médica</label>
                            <textarea id="indicaciones" name="indicaciones" class="form-control rounded-3" rows="4" placeholder="Medicamentos prescritos, dosis, días de tratamiento o reposo..." required></textarea>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <button type="submit" class="btn btn-success btn-lg rounded-pill px-4">
                                <i class="bi bi-check-circle me-1"></i> Finalizar Consulta
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>