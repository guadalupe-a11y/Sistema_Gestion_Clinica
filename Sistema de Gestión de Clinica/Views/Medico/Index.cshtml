@model IEnumerable<Sistema_Gestión_Clinica.Models.Cita>
@{
    ViewData["Title"] = "Panel del Médico";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-primary fw-bold mb-1">
                <i class="bi bi-hospital me-2"></i>Panel del Consultorio
            </h2>
            <p class="text-muted mb-0">Gestión de turnos y llamadas de pacientes en sala de espera.</p>
        </div>
        <span class="badge bg-info text-dark fs-6 px-3 py-2 rounded-pill">
            <i class="bi bi-calendar-event me-1"></i> @DateTime.Today.ToString("dd/MM/yyyy")
        </span>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 border-0">
            <h5 class="fw-bold text-secondary mb-0">Fila de Citas Programadas</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Hora</th>
                        <th>Paciente</th>
                        <th>DUI</th>
                        <th>Médico</th>
                        <th>Estado</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var cita in Model)
                        {
                            var nombreEstado = cita.EstadoCita?.NombreEstado ?? "Agendada";
                            var esProxima = nombreEstado == "En Espera" || nombreEstado == "Agendada" || nombreEstado == "Pendiente";
                            var esEnConsulta = nombreEstado == "En Consulta";

                            <tr class="@(esEnConsulta ? "table-warning" : "")">
                                <td class="ps-4 fw-bold text-primary">
                                    @cita.FechaHora.ToString("HH:mm")
                                </td>
                                <td>
                                    <div class="fw-semibold">@(cita.Paciente != null ? $"{cita.Paciente.Nombre} {cita.Paciente.Apellido}" : "Sin registrar")</div>
                                </td>
                                <td>@(cita.Paciente?.DUI ?? "N/A")</td>
                                <td>@(cita.Medico != null ? $"Dr/a. {cita.Medico.Nombre} {cita.Medico.Apellido}" : "N/A")</td>
                                <td>
                                    @if (esEnConsulta)
                                    {
                                        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">
                                            <i class="bi bi-arrow-repeat me-1"></i>En Consulta
                                        </span>
                                    }
                                    else if (nombreEstado == "Finalizada")
                                    {
                                        <span class="badge bg-success px-3 py-2 rounded-pill">
                                            <i class="bi bi-check-lg me-1"></i>Finalizada
                                        </span>
                                    }
                                    else if (nombreEstado == "En Espera")
                                    {
                                        <span class="badge bg-info text-dark px-3 py-2 rounded-pill">
                                            <i class="bi bi-person-clock me-1"></i>En Espera
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary px-3 py-2 rounded-pill">
                                            @nombreEstado
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    @if (esEnConsulta)
                                    {
                                        <a asp-action="Atender" asp-route-idCita="@cita.IdCita" class="btn btn-warning btn-sm rounded-pill px-3 fw-bold">
                                            <i class="bi bi-play-fill me-1"></i>Continuar
                                        </a>
                                    }
                                    else if (esProxima)
                                    {
                                        <form asp-action="LlamarSiguiente" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="idCita" value="@cita.IdCita" />
                                            <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3">
                                                <i class="bi bi-megaphone me-1"></i>Llamar Siguiente
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button class="btn btn-light btn-sm rounded-pill px-3 text-muted" disabled>
                                            Atendido
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-calendar-x fs-1 d-block mb-2 text-secondary"></i>
                                No hay citas registradas para la fila de hoy.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>