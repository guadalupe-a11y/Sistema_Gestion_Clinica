@{
    ViewData["Title"] = "Panel de Administración";
}

<div class="container-fluid py-4 px-4">
    <!-- Encabezado de la página -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-shield-check text-primary me-2"></i>Panel de Administración
            </h2>
            <p class="text-muted small mb-0">Gestión global, monitoreo de métricas e indicadores de rendimiento del sistema.</p>
        </div>
        <div class="d-flex gap-2">
            <span class="badge bg-white text-dark shadow-sm px-3 py-2 border rounded-pill d-flex align-items-center gap-2">
                <i class="bi bi-circle-fill text-success fs-6"></i> Sistema Operativo
            </span>
            <span class="badge bg-primary px-3 py-2 rounded-pill d-flex align-items-center gap-1">
                <i class="bi bi-calendar3"></i> @DateTime.Now.ToString("dd/MM/yyyy")
            </span>
        </div>
    </div>

    <!-- Métricas Principales (KPIs) -->
    <div class="row g-4 mb-4">
        <!-- Tarjeta 1: Médicos -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden card-hover position-relative" style="background: linear-gradient(135deg, #0d6efd, #0a58ca);">
                <div class="card-body text-white p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-white-50 fw-semibold text-uppercase small">Personal Médico</span>
                        <div class="p-2 bg-white bg-opacity-25 rounded-3">
                            <i class="bi bi-hospital fs-4 text-white"></i>
                        </div>
                    </div>
                    <h2 class="display-6 fw-bold mb-0">@(ViewBag.TotalMedicos ?? 0)</h2>
                    <small class="text-white-50"><i class="bi bi-check2-circle me-1"></i>Médicos activos registradas</small>
                </div>
            </div>
        </div>

        <!-- Tarjeta 2: Pacientes -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden card-hover position-relative" style="background: linear-gradient(135deg, #198754, #146c43);">
                <div class="card-body text-white p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-white-50 fw-semibold text-uppercase small">Pacientes Activos</span>
                        <div class="p-2 bg-white bg-opacity-25 rounded-3">
                            <i class="bi bi-people-fill fs-4 text-white"></i>
                        </div>
                    </div>
                    <h2 class="display-6 fw-bold mb-0">@(ViewBag.TotalPacientes ?? 0)</h2>
                    <small class="text-white-50"><i class="bi bi-folder-check me-1"></i>Expedientes clínicos vigentes</small>
                </div>
            </div>
        </div>

        <!-- Tarjeta 3: Citas de Hoy -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden card-hover position-relative" style="background: linear-gradient(135deg, #0dcaf0, #0aa2c0);">
                <div class="card-body text-white p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-white-50 fw-semibold text-uppercase small">Citas Programadas Hoy</span>
                        <div class="p-2 bg-white bg-opacity-25 rounded-3">
                            <i class="bi bi-calendar2-check-fill fs-4 text-white"></i>
                        </div>
                    </div>
                    <h2 class="display-6 fw-bold mb-0">@(ViewBag.CitasHoy ?? 0)</h2>
                    <small class="text-white-50"><i class="bi bi-clock-history me-1"></i>Agenda del día actual</small>
                </div>
            </div>
        </div>

        <!-- Tarjeta 4: Lista de Espera -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden card-hover position-relative" style="background: linear-gradient(135deg, #ffc107, #fd7e14);">
                <div class="card-body text-white p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-white-50 fw-semibold text-uppercase small">En Lista de Espera</span>
                        <div class="p-2 bg-white bg-opacity-25 rounded-3">
                            <i class="bi bi-hourglass-split fs-4 text-white"></i>
                        </div>
                    </div>
                    <h2 class="display-6 fw-bold mb-0">@(ViewBag.EnListaEspera ?? 0)</h2>
                    <small class="text-white-50"><i class="bi bi-arrow-repeat me-1"></i>Pendientes de reasignación</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Módulos de Gestión Rápida -->
    <h5 class="fw-bold text-secondary mb-3">Módulos de Gestión</h5>
    <div class="row g-4">
        <!-- Gestión Médica -->
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 card-hover bg-white p-2">
                <div class="card-body p-4 text-center">
                    <div class="mb-3 d-inline-block p-3 rounded-circle bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-person-badge fs-1"></i>
                    </div>
                    <h5 class="card-title fw-bold text-dark">Gestión de Médicos</h5>
                    <p class="card-text text-muted small mb-4">Administra el alta de doctores, asignación de especialidades y datos de contacto.</p>
                    <a asp-controller="Admin" asp-action="Medicos" class="btn btn-primary rounded-pill px-4 py-2 w-100 fw-semibold">
                        <i class="bi bi-arrow-right-circle me-1"></i> Administrar Médicos
                    </a>
                </div>
            </div>
        </div>

        <!-- Horarios de Atención -->
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 card-hover bg-white p-2">
                <div class="card-body p-4 text-center">
                    <div class="mb-3 d-inline-block p-3 rounded-circle bg-success bg-opacity-10 text-success">
                        <i class="bi bi-clock-history fs-1"></i>
                    </div>
                    <h5 class="card-title fw-bold text-dark">Horarios y Consultorios</h5>
                    <p class="card-text text-muted small mb-4">Configura turnos de atención, asignación de consultorios y cupos por hora.</p>
                    <a asp-controller="Admin" asp-action="Horarios" class="btn btn-success rounded-pill px-4 py-2 w-100 fw-semibold">
                        <i class="bi bi-sliders me-1"></i> Configurar Horarios
                    </a>
                </div>
            </div>
        </div>

        <!-- Usuarios y Seguridad -->
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 card-hover bg-white p-2">
                <div class="card-body p-4 text-center">
                    <div class="mb-3 d-inline-block p-3 rounded-circle bg-danger bg-opacity-10 text-danger">
                        <i class="bi bi-shield-lock fs-1"></i>
                    </div>
                    <h5 class="card-title fw-bold text-dark">Control de Usuarios</h5>
                    <p class="card-text text-muted small mb-4">Gestión de credenciales, roles de acceso (Admin, Médico, Recepción, Paciente) y estado.</p>
                    <a asp-controller="Admin" asp-action="Usuarios" class="btn btn-danger rounded-pill px-4 py-2 w-100 fw-semibold">
                        <i class="bi bi-people me-1"></i> Gestionar Cuentas
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Estilos para animación de elevación al pasar el cursor -->
<style>
    .card-hover {
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }
    .card-hover:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.12) !important;
    }
</style>