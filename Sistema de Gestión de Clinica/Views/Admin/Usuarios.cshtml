@model IEnumerable<Sistema_Gestión_Clinica.Models.Usuario>
@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark mb-0">👥 Gestión de Usuarios</h2>
        <button type="button" class="btn btn-primary rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalUsuario">
            <i class="bi bi-plus-lg me-1"></i> Nuevo Usuario
        </button>
    </div>

    <!-- Alertas -->
    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Tabla -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Correo Electrónico</th>
                        <th>Rol</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var u in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-secondary">@u.IdUsuario</td>
                                <td>@u.Correo</td>
                                <td>
                                    <span class="badge bg-info text-dark px-3 py-2 rounded-pill">
                                        @(u.Rol?.NombreRol ?? "Usuario")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-success px-3 py-2 rounded-pill">
                                        @(u.Activo ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">No hay usuarios registrados.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL INDEPENDIENTE -->
<div class="modal fade" id="modalUsuario" tabindex="-1" aria-labelledby="modalUsuarioLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-primary text-white rounded-top-4">
                <h5 class="modal-title fw-bold" id="modalUsuarioLabel">
                    <i class="bi bi-person-fill-add me-2"></i>Crear Nuevo Usuario
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-controller="Admin" asp-action="CrearUsuario" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4 bg-white">
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark">Correo Electrónico</label>
                        <input type="email" name="correo" class="form-control rounded-3" placeholder="correo@ejemplo.com" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark">Contraseña</label>
                        <input type="password" name="contrasena" class="form-control rounded-3" placeholder="••••••••" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark">Rol de Usuario</label>
                        <select name="idRol" class="form-select rounded-3" asp-items="ViewBag.Roles" required>
                            <option value="">-- Seleccionar Rol --</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Crear Usuario</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- SCRIPT DE AUTO-REUBICACIÓN DEL MODAL -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var modalElement = document.getElementById('modalUsuario');
        if (modalElement) {
            document.body.appendChild(modalElement);
        }
    });
</script>