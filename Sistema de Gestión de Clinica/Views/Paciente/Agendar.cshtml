@model Sistema_Gestión_Clinica.ViewModels.AgendarCitaViewModel
@using Sistema_Gestión_Clinica.Models
@{
    ViewData["Title"] = "Agendar cita";
    var especialidades = ViewBag.Especialidades as IEnumerable<Especialidad> ?? new List<Especialidad>();
    var todosMedicos = ViewBag.Medicos as IEnumerable<Medico> ?? new List<Medico>();
    var medicos = todosMedicos.Where(m => Model.IdEspecialidad > 0 && m.IdEspecialidad == Model.IdEspecialidad);
    var horaTxt = Model.Hora.ToString(@"hh\:mm");
    var hoyTxt = DateTime.Today.ToString("yyyy-MM-dd");
}

<h2>Agendar cita</h2>
<p class="text-muted mb-2">Elige una especialidad:</p>
<partial name="_EspecialidadesGaleria" model="especialidades" />
<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="Agendar" method="post" id="formCita" data-hora="@horaTxt" data-id-cita="@Model.IdCita">
    <div class="mb-3">
        <label>Especialidad</label>
        <select asp-for="IdEspecialidad" id="IdEspecialidad" class="form-control">
            <option value="">-- Seleccione --</option>
            @foreach (var e in especialidades)
            {
                <option value="@e.IdEspecialidad">@e.NombreEspecialidad</option>
            }
        </select>
        <span asp-validation-for="IdEspecialidad" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Médico</label>
        <select asp-for="IdMedico" id="IdMedico" class="form-control">
            <option value="">-- Seleccione --</option>
            @foreach (var m in medicos)
            {
                <option value="@m.IdMedico">@m.Nombre @m.Apellido</option>
            }
        </select>
        <span asp-validation-for="IdMedico" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Fecha"></label>
        <input asp-for="Fecha" id="Fecha" type="date" class="form-control" min="@hoyTxt" />
        <span asp-validation-for="Fecha" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Hora</label>
        <select asp-for="Hora" id="Hora" class="form-control">
            <option value="">-- Seleccione médico y fecha --</option>
        </select>
        <span asp-validation-for="Hora" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Motivo"></label>
        <textarea asp-for="Motivo" class="form-control"></textarea>
        <span asp-validation-for="Motivo" class="text-danger"></span>
    </div>

    <button class="btn btn-primary">Agendar</button>
    <a asp-action="MisCitas" class="btn btn-secondary">Volver</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var form = document.getElementById('formCita');
            var selEsp = document.getElementById('IdEspecialidad');
            var selMed = document.getElementById('IdMedico');
            var inpFecha = document.getElementById('Fecha');
            var selHora = document.getElementById('Hora');

            if (!(form instanceof HTMLFormElement) ||
                !(selEsp instanceof HTMLSelectElement) ||
                !(selMed instanceof HTMLSelectElement) ||
                !(inpFecha instanceof HTMLInputElement) ||
                !(selHora instanceof HTMLSelectElement)) return;

            var horaInicial = form.getAttribute('data-hora') || '';
            var idCita = form.getAttribute('data-id-cita') || '0';

            function resetSelect(sel, texto) {
                sel.innerHTML = '';
                sel.add(new Option(texto, ''));
            }

            async function cargarMedicos() {
                resetSelect(selMed, '-- Seleccione --');
                resetSelect(selHora, '-- Seleccione médico y fecha --');
                if (!selEsp.value) return;
                var r = await fetch('/Paciente/GetMedicos?idEspecialidad=' + selEsp.value);
                var data = await r.json();
                for (var i = 0; i < data.length; i++) {
                    var medico = data[i];
                    selMed.add(new Option(medico.nombre, medico.idMedico));
                }
            }

            async function cargarHoras(horaSeleccionada = '') {
                resetSelect(selHora, '-- Seleccione --');
                if (!selMed.value || !inpFecha.value) return;
                var url = '/Paciente/GetHorasDisponibles?idMedico=' + selMed.value + '&fecha=' + inpFecha.value;
                if (idCita !== '0') url += '&idCita=' + idCita;
                var r = await fetch(url);
                var data = await r.json();
                if (data.length === 0) {
                    resetSelect(selHora, 'Sin horarios disponibles ese día');
                    return;
                }
                for (var i = 0; i < data.length; i++) {
                    var hora = data[i];
                    selHora.add(new Option(hora.texto, hora.valor));
                }
                if (horaSeleccionada && horaSeleccionada !== '00:00') selHora.value = horaSeleccionada;
            }

            selEsp.addEventListener('change', function () { cargarMedicos(); });
            selMed.addEventListener('change', function () { cargarHoras(''); });
            inpFecha.addEventListener('change', function () { cargarHoras(''); });

            // Si vuelve del servidor con un error, conserva lo elegido
            document.addEventListener('DOMContentLoaded', function () {
                if (selMed.value && inpFecha.value) cargarHoras(horaInicial);
            });
        })();
    </script>
}
