@model Sistema_Gestión_Clinica.ViewModels.AgendarCitaViewModel
@{
    ViewData["Title"] = "Reprogramar cita";
    var horaTxt = Model.Hora.ToString(@"hh\:mm");
    var hoyTxt = DateTime.Today.ToString("yyyy-MM-dd");
}

<h2>Reprogramar cita</h2>
<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="Reprogramar" method="post" id="formReprogramar"
      data-hora="@horaTxt" data-id-cita="@Model.IdCita" data-id-medico="@Model.IdMedico">
    <input type="hidden" asp-for="IdCita" />
    <input type="hidden" asp-for="IdMedico" />
    <input type="hidden" asp-for="IdEspecialidad" />

    <div class="mb-3">
        <label asp-for="Fecha"></label>
        <input asp-for="Fecha" id="FechaRep" type="date" class="form-control" min="@hoyTxt" />
        <span asp-validation-for="Fecha" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Hora"></label>
        <select asp-for="Hora" id="HoraRep" class="form-control">
            <option value="">-- Seleccione una fecha --</option>
        </select>
        <span asp-validation-for="Hora" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Motivo"></label>
        <textarea asp-for="Motivo" class="form-control"></textarea>
        <span asp-validation-for="Motivo" class="text-danger"></span>
    </div>

    <button class="btn btn-primary">Guardar cambios</button>
    <a asp-action="MisCitas" class="btn btn-secondary">Volver</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var form = document.getElementById('formReprogramar');
            var inpFecha = document.getElementById('FechaRep');
            var selHora = document.getElementById('HoraRep');

            if (!(form instanceof HTMLFormElement) ||
                !(inpFecha instanceof HTMLInputElement) ||
                !(selHora instanceof HTMLSelectElement)) return;

            var idMedico = form.getAttribute('data-id-medico') || '0';
            var idCita = form.getAttribute('data-id-cita') || '0';
            var horaInicial = form.getAttribute('data-hora') || '';

            function resetHora(texto = '') {
                selHora.innerHTML = '';
                selHora.add(new Option(texto, ''));
            }

            async function cargarHoras(horaSeleccionada = '') {
                resetHora('-- Seleccione --');
                if (!inpFecha.value) return;

                var url = '/Paciente/GetHorasDisponibles?idMedico=' + idMedico +
                    '&fecha=' + inpFecha.value + '&idCita=' + idCita;
                var r = await fetch(url);
                var data = await r.json();

                if (data.length === 0) {
                    resetHora('Sin horarios disponibles ese día');
                    return;
                }
                for (var i = 0; i < data.length; i++) {
                    var hora = data[i];
                    selHora.add(new Option(hora.texto, hora.valor));
                }
                if (horaSeleccionada) selHora.value = horaSeleccionada;
            }

            inpFecha.addEventListener('change', function () { cargarHoras(''); });
            document.addEventListener('DOMContentLoaded', function () { cargarHoras(horaInicial); });
        })();
    </script>
}